# Copiar a `.env` en esta misma carpeta y rellenar con valores reales.
# El `.env` real NUNCA debe commitearse (ya está en .gitignore).

# Genera cada WEBUI_SECRET_KEY con algo como: openssl rand -hex 32
WEBUI_SECRET_KEY_RH=changeme-generate-random-string
WEBUI_SECRET_KEY_CALIDAD=changeme-generate-random-string
WEBUI_SECRET_KEY_PRODUCCION=changeme-generate-random-string
WEBUI_SECRET_KEY_ID=changeme-generate-random-string
WEBUI_SECRET_KEY_VENTAS=changeme-generate-random-string

# API keys de Groq (una por departamento, o la misma si comparten cuenta)
GROQ_API_KEY_RH=changeme
GROQ_API_KEY_CALIDAD=changeme
GROQ_API_KEY_PRODUCCION=changeme
GROQ_API_KEY_ID=changeme
GROQ_API_KEY_VENTAS=changeme

# PostgreSQL
POSTGRES_USER=changeme
POSTGRES_PASSWORD=changeme
POSTGRES_DB=solomia
